    <pair geom1="cube_geom" geom2="container_wall_c01" condim="3" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1 1 0.005 0.0001 0.0001"/>
    <pair geom1="cube_geom" geom2="container_wall_c02" condim="3" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1 1 0.005 0.0001 0.0001"/>
    <pair geom1="cube_geom" geom2="container_wall_c03" condim="3" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1 1 0.005 0.0001 0.0001"/>
    <pair geom1="cube_geom" geom2="container_floor_c1" condim="3" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1 1 0.005 0.0001 0.0001"/>
