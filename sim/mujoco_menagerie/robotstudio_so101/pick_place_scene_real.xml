    <!-- container:end -->
  </worldbody>

  <keyframe>
    <!-- Start pose = where the arm actually rests in the recorded demos: the median first frame of the
         first 6 leader takes (2026-11-21; leader units pan 0.7, lift -100.7 (sim limit), elbow 88.9,
         wrist_flex 76.1, roll 2.4, gripper 0.4). Clear of the table by 24 mm and of every cube pose in
         eval/cube_poses.json by >= 22 mm. Teleop resets here and follows the leader once every joint is
         within 15 deg; eval starts here. (Earlier: real rest measured once, with margins.) -->
    <key name="ready"
      qpos="0 -1.745 1.4329 1.2854 0.0955 -0.1649  0.18 0.14 0.02 1 0 0 0"
      ctrl="0 -1.745 1.4329 1.2854 0.0955 -0.1649"/>
  </keyframe>
  <!-- Cube contacts (2026-11-21). The gripper's finger collision shapes are thin plates (2 mm),
       and with the default soft contacts the jaws sank ~5 mm into the cube while squeezing (and
       could tunnel through), and pressing pushed the cube ~7 mm into the table. Explicit pairs:
       cube-finger contacts start 1.5 mm out (margin) and are stiffer, so the jaws stop at the
       surface (~0.35 mm gap while holding); cube-table is stiffer. Cube scene only. -->
  <contact>
    <exclude body1="cube" body2="gripper"/>
    <exclude body1="cube" body2="moving_jaw_so101_v1"/>
    <exclude body1="cube" body2="table"/>
    <pair geom1="cube_geom" geom2="gripper_wrist_box" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_mesh" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="moving_jaw_mesh0" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="moving_jaw_mesh1" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_box1" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_box2" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_box3" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_box4" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_box5" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_box6" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_box7" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_sph_tip1" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_sph_tip2" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="fixed_jaw_sph_tip3" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
    <pair geom1="cube_geom" geom2="moving_jaw_box1" condim="4" margin="0.0015" solref="0.01 1" solimp="0.95 0.99 0.001" friction="1.5 1.5 0.005 0.0005 0.0005"/>
