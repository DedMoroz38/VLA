<mujoco model="so101_pick_place">
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_white" rgba="0.92 0.92 0.90 1" reflectance="0.1" specular="0.3" shininess="0.2"/>
    <material name="container_mat" rgba="0.55 0.55 0.6 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <light pos="0.3 0.2 1.2" dir="-0.2 -0.1 -1" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>

    <!-- Room floor, well below the tabletop so the table legs have somewhere to stand. -->
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.75" type="plane" material="groundplane"/>

    <!-- White table. Robot base is mounted directly on the tabletop at z=0 (unchanged
         from the original scene), legs reach down ~0.73 m to the room floor
         (typical desk height). -->
    <body name="table">
      <geom name="table_top" type="box" pos="0.15 0 -0.01" size="0.35 0.3 0.01" material="table_white"/>
      <geom name="table_leg_fl" type="box" pos="-0.17 0.27 -0.385" size="0.02 0.02 0.365" material="table_white"/>
      <geom name="table_leg_fr" type="box" pos="-0.17 -0.27 -0.385" size="0.02 0.02 0.365" material="table_white"/>
      <geom name="table_leg_bl" type="box" pos="0.47 0.27 -0.385" size="0.02 0.02 0.365" material="table_white"/>
      <geom name="table_leg_br" type="box" pos="0.47 -0.27 -0.385" size="0.02 0.02 0.365" material="table_white"/>
    </body>

    <!-- Eraser: pick object. Rests on the tabletop (top surface at z=0). -->
    <body name="eraser" pos="0.18 0.14 0.015">
      <freejoint/>
      <geom name="eraser_geom" type="box" size="0.035 0.015 0.015" mass="0.04" friction="1 0.005 0.0001"
        rgba="0.1 0.3 0.9 1"/>
    </body>

    <!-- Placement container: open-top tray fixed to the tabletop. -->
    <body name="container" pos="0.18 -0.14 0">
      <geom name="container_floor" type="box" pos="0 0 0.0048" size="0.0588 0.0468 0.0048" material="container_mat"/>
      <geom name="container_wall_px" type="box" pos="0.0588 0 0.0396" size="0.0015 0.0468 0.03" material="container_mat"/>
      <geom name="container_wall_nx" type="box" pos="-0.0588 0 0.0396" size="0.0015 0.0468 0.03" material="container_mat"/>
      <geom name="container_wall_py" type="box" pos="0 0.0468 0.0396" size="0.0588 0.0015 0.03" material="container_mat"/>
      <geom name="container_wall_ny" type="box" pos="0 -0.0468 0.0396" size="0.0588 0.0015 0.03" material="container_mat"/>
    </body>

    <!-- Fixed external camera: ~45 deg down from horizontal, ~25 deg to the
         front-left of the robot (robot "front" = +X, "left" = +Y), aimed at the
         workspace center between the eraser and the container. Distance/height
         are placeholder estimates for a tripod-mounted webcam -- replace pos/
         xyaxes with values measured from the real rig once available. -->
    <camera name="ext_cam" mode="fixed" pos="0.3797 0.1289 0.401"
      xyaxes="-0.4226 0.9063 0  -0.6409 -0.2989 0.7072" fovy="58"/>
  </worldbody>

  <keyframe>
    <key name="ready"
      qpos="0 -0.55 0.25 1.60 0 1.2  0.18 0.14 0.015 1 0 0 0"
      ctrl="0 -0.55 0.25 1.60 0 1.2"/>
  </keyframe>
</mujoco>
