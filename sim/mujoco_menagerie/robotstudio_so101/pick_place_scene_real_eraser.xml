<mujoco model="so101_pick_place_real_eraser">
  <!-- Kept copy: the real-look scene with the original eraser + tray task, so
       the recorded demos (which use the eraser) can still be re-rendered with
       the real look. pick_place_scene_real.xml now holds the 40 mm cube. -->
  <!-- Real-look variant of pick_place_scene.xml, matched to the lab rig's two
       cameras (see sim/calib/README.md). Same task, same physics: the eraser,
       tray, robot and tabletop height (z=0) are unchanged, so every recorded
       demo replays and re-renders in this scene.

       What differs from pick_place_scene.xml:
       - white printed robot parts and the fitted wrist_cam (so101_real.xml)
       - a larger table whose back edge sits ~4 cm behind the robot base, as on
         the real rig
       - ext_cam moved to the real side camera: in front of the robot, facing
         it across the table, Logitech C920 FOV at 640x480, pose fitted to
         frames of the real arm
       - neutral grey table and lighting tuned to the real camera frames
       The background (floor, skybox) is deliberately left as in the original. -->
  <include file="so101_real.xml"/>

  <visual>
    <headlight diffuse="0.15 0.15 0.15" ambient="0.7 0.7 0.7" specular="0 0 0"/>
    <quality shadowsize="4096"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="180" elevation="-35"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_white" rgba="0.58 0.595 0.58 1" reflectance="0" specular="0"/>
    <material name="container_mat" rgba="0.55 0.55 0.6 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <!-- Lab lighting: diffuse ceiling panels, so mostly ambient (headlight) and one
         soft overhead light. Tuned so table and robot pixel values match the
         real side-cam frame (calib/compare_views.py). -->
    <light name="ceiling" pos="0.3 0 1.5" dir="0 0 -1" type="spot" cutoff="70" exponent="0"
      diffuse="0.15 0.15 0.15" specular="0 0 0" bulbradius="0.5" castshadow="true"/>

    <geom name="floor" size="0 0 0.05" pos="0 0 -0.75" type="plane" material="groundplane"/>

    <!-- Table: back edge at x=-0.071 (fitted from the real side-cam frames, see
         calib/side_cam_fit.json), ~4 cm behind the base footprint (base spans
         x -0.031..0.065); 1.2 m wide and running to x=0.915 towards the camera,
         so its side and front edges stay out of the side camera's view. -->
    <body name="table">
      <geom name="table_top" type="box" pos="0.422 0 -0.01" size="0.493 0.6 0.01" material="table_white"/>
      <geom name="table_leg_fl" type="box" pos="-0.041 0.57 -0.385" size="0.02 0.02 0.365" material="table_white"/>
      <geom name="table_leg_fr" type="box" pos="-0.041 -0.57 -0.385" size="0.02 0.02 0.365" material="table_white"/>
      <geom name="table_leg_bl" type="box" pos="0.885 0.57 -0.385" size="0.02 0.02 0.365" material="table_white"/>
      <geom name="table_leg_br" type="box" pos="0.885 -0.57 -0.385" size="0.02 0.02 0.365" material="table_white"/>
    </body>

    <body name="eraser" pos="0.18 0.14 0.015">
      <freejoint/>
      <geom name="eraser_geom" type="box" size="0.035 0.015 0.015" mass="0.04" friction="1 0.005 0.0001"
        rgba="0.1 0.3 0.9 1"/>
    </body>

    <body name="container" pos="0.18 -0.14 0">
      <geom name="container_floor" type="box" pos="0 0 0.0048" size="0.0588 0.0468 0.0048" material="container_mat"/>
      <geom name="container_wall_px" type="box" pos="0.0588 0 0.0396" size="0.0015 0.0468 0.03" material="container_mat"/>
      <geom name="container_wall_nx" type="box" pos="-0.0588 0 0.0396" size="0.0015 0.0468 0.03" material="container_mat"/>
      <geom name="container_wall_py" type="box" pos="0 0.0468 0.0396" size="0.0588 0.0015 0.03" material="container_mat"/>
      <geom name="container_wall_ny" type="box" pos="0 -0.0468 0.0396" size="0.0588 0.0015 0.03" material="container_mat"/>
    </body>

    <!-- Side camera (real: Logitech C920 at 640x480, a 4:3 centre crop of its
         1080p frame, so vertical FOV 43.3 deg). In front of the robot facing
         it, pitched 45 deg down. Fitted (calib/fit_side_cam.py) to 9 frames of
         the real arm in known poses plus the real table's back edge: mean
         robot-silhouette IoU 0.64, table edge within 0.35 px. -->
    <camera name="ext_cam" mode="fixed" pos="0.594 0.0054 0.4934"
      xyaxes="-0.009 0.9998 -0.0197  -0.7071 0.0076 0.7071" fovy="43.3"/>
  </worldbody>

  <keyframe>
    <key name="ready"
      qpos="0 -0.55 0.25 1.60 0 1.2  0.18 0.14 0.015 1 0 0 0"
      ctrl="0 -0.55 0.25 1.60 0 1.2"/>
  </keyframe>
</mujoco>
